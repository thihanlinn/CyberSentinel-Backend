from fastapi import FastAPI
from pydantic import BaseModel
import requests
import sqlite3
import logging
import smtplib
from email.message import EmailMessage
from datetime import datetime
import uvicorn

# ---------------- CONFIGURATION ----------------

app = FastAPI(title="CyberSentinel Bot", version="3.0")

GOOGLE_API_KEY = "YOUR_GOOGLE_SAFE_BROWSING_KEY"
VT_API_KEY = "YOUR_VIRUSTOTAL_API_KEY"
EMAIL_SENDER = "yourgmail@gmail.com"
EMAIL_APP_PASSWORD = "your_app_password"
DEFAULT_EMAIL_RECEIVER = "youremail@gmail.com"

logging.basicConfig(filename="scan_log.txt", level=logging.INFO, format="%(asctime)s - %(message)s")

# ------------- DATABASE SETUP ----------------

def init_db():
    conn = sqlite3.connect("scans.db")
    conn.execute("""
        CREATE TABLE IF NOT EXISTS scans (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            url TEXT,
            user_id TEXT,
            email TEXT,
            risk TEXT,
            threats TEXT,
            timestamp TEXT
        );
    """)
    conn.commit()
    conn.close()

init_db()

# ------------- REQUEST MODEL ----------------

class URLRequest(BaseModel):
    url: str
    user_id: str = "guest"
    email: str | None = None

# ------------- UTILITY FUNCTIONS ----------------

def save_to_db(url, user_id, email, risk, threats):
    try:
        conn = sqlite3.connect("scans.db")
        conn.execute(
            "INSERT INTO scans (url, user_id, email, risk, threats, timestamp) VALUES (?, ?, ?, ?, ?, ?)",
            (url, user_id, email, risk, threats, datetime.utcnow().isoformat())
        )
        conn.commit()
        conn.close()
    except Exception as e:
        logging.error(f"DB error: {e}")

def send_email_alert(url, risk, threats, receiver):
    subject = "🚨 CyberSentinel Alert"
    body = f"URL: {url}\nRisk: {risk}\nThreats: {', '.join(threats)}"
    msg = EmailMessage()
    msg["From"] = EMAIL_SENDER
    msg["To"] = receiver
    msg["Subject"] = subject
    msg.set_content(body)
    try:
        with smtplib.SMTP_SSL("smtp.gmail.com", 465) as smtp:
            smtp.login(EMAIL_SENDER, EMAIL_APP_PASSWORD)
            smtp.send_message(msg)
        logging.info(f"Email sent to {receiver}")
    except Exception as e:
        logging.error(f"Email error: {e}")

# ------------- SCAN HELPERS ----------------

def scan_with_google(url):
    try:
        res = requests.post(
            f"https://safebrowsing.googleapis.com/v4/threatMatches:find?key={GOOGLE_API_KEY}",
            json={
                "client": {"clientId": "cybersentinel", "clientVersion": "1.0"},
                "threatInfo": {
                    "threatTypes": ["MALWARE", "SOCIAL_ENGINEERING", "UNWANTED_SOFTWARE"],
                    "platformTypes": ["ANY_PLATFORM"],
                    "threatEntryTypes": ["URL"],
                    "threatEntries": [{"url": url}]
                }
            },
            timeout=10
        )
        data = res.json()
        if "matches" in data:
            threats = list({match["threatType"] for match in data["matches"]})
            return "❌ Dangerous", threats
        return "✅ Safe", []
    except Exception as e:
        logging.error(f"Google scan error: {e}")
        return "⚠️ Unknown", []

def scan_with_virustotal(url):
    try:
        headers = {"x-apikey": VT_API_KEY}
        res = requests.post("https://www.virustotal.com/api/v3/urls", headers=headers, data={"url": url})
        scan_id = res.json()["data"]["id"]
        result = requests.get(f"https://www.virustotal.com/api/v3/analyses/{scan_id}", headers=headers).json()
        stats = result["data"]["attributes"]["stats"]
        if stats["malicious"] > 0:
            return "❌ Dangerous", ["Malicious"]
        elif stats["suspicious"] > 0:
            return "⚠️ Suspicious", ["Suspicious"]
        return "✅ Safe", []
    except Exception as e:
        logging.error(f"VT scan error: {e}")
        return "⚠️ Unknown", []

# ------------- MAIN ENDPOINT ----------------

@app.post("/scan-url")
def scan_url(request: URLRequest):
    user_email = request.email or DEFAULT_EMAIL_RECEIVER

    risk_g, threats_g = scan_with_google(request.url)
    risk_v, threats_v = scan_with_virustotal(request.url)

    all_threats = threats_g + threats_v
    risk_status = "❌ Dangerous" if "❌" in (risk_g + risk_v) else "⚠️ Suspicious" if "⚠️" in (risk_g + risk_v) else "✅ Safe"

    if risk_status == "❌ Dangerous":
        send_email_alert(request.url, risk_status, all_threats, user_email)

    save_to_db(request.url, request.user_id, user_email, risk_status, ", ".join(all_threats))
    logging.info(f"{request.user_id} scanned {request.url} → {risk_status} | Threats: {all_threats}")

    return {
        "url": request.url,
        "risk": risk_status,
        "threats": all_threats,
        "email_alert": user_email if risk_status == "❌ Dangerous" else None,
        "sources": {
            "Google Safe Browsing": {"risk": risk_g, "threats": threats_g},
            "VirusTotal": {"risk": risk_v, "threats": threats_v}
        }
    }

# ------------- RUN ----------------

if __name__ == "__main__":
    uvicorn.run("main:app", host="127.0.0.1", port=8000, reload=True)
